<Window x:Class="DiskUsage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DiskUsage.ViewModels"
        mc:Ignorable="d"
        Title="DiskUsage - Space &amp; Hierarchy Explorer" 
        Height="720" Width="1180"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F5F7">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Scan Controls -->
            <RowDefinition Height="Auto" />
            <!-- 1: Navigation & Breadcrumbs & Search Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Split Content Area -->
            <RowDefinition Height="*" />
            <!-- 3: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP BAR (Folder Picker & Scan Actions) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="💾" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="DiskUsage" FontSize="18" FontWeight="Bold" Foreground="#1A1D20" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Folder Path Input -->
                <TextBox Grid.Column="1" 
                         Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" 
                         Padding="8,6" 
                         FontSize="13"
                         Background="#F8F9FA"
                         BorderBrush="#CED4DA"
                         BorderThickness="1"
                         Margin="0,0,8,0" />

                <!-- Browse Button -->
                <Button Grid.Column="2" 
                        Content="Browse..." 
                        Command="{Binding BrowseFolderCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" 
                        Margin="0,0,8,0" />

                <!-- Scan / Rescan Button -->
                <Button Grid.Column="3" 
                        Content="▶ Scan Folder" 
                        Command="{Binding StartScanCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Margin="0,0,8,0" />

                <!-- Cancel Button -->
                <Button Grid.Column="4" 
                        Content="⏹ Cancel" 
                        Command="{Binding CancelScanCommand}"
                        Style="{StaticResource DangerButtonStyle}" />
            </Grid>
        </Border>

        <!-- ROW 1: NAVIGATION & BREADCRUMBS & FILTER BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Nav buttons (Back, Forward, Up) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Breadcrumbs trail -->
                    <ColumnDefinition Width="*" />
                    <!-- Filter/Search box -->
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button Content="🠔" Command="{Binding NavigateBackCommand}" ToolTip="Back" Style="{StaticResource NavIconButton}" Margin="0,0,4,0" />
                    <Button Content="🠖" Command="{Binding NavigateForwardCommand}" ToolTip="Forward" Style="{StaticResource NavIconButton}" Margin="0,0,4,0" />
                    <Button Content="🠕" Command="{Binding NavigateUpCommand}" ToolTip="Up One Level" Style="{StaticResource NavIconButton}" Margin="0,0,8,0" />
                </StackPanel>

                <!-- Breadcrumb Path -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#0D6EFD"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Padding="4,2" />
                                    <TextBlock Text="❯" Margin="4,0" Foreground="#ADB5BD" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Search / Filter -->
                <Border Grid.Column="2" Background="#F8F9FA" BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="#6C757D" FontSize="12" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 FontSize="12" 
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <Label Content="Filter by name / ext..." Foreground="#999" FontSize="12" Padding="2,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 2: MAIN SPLIT CONTENT AREA -->
        <Grid Grid.Row="2" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: TreeView (320px default) -->
                <ColumnDefinition Width="320" MinWidth="200" />
                <!-- GridSplitter -->
                <ColumnDefinition Width="8" />
                <!-- Right Pane: Details DataGrid -->
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: FOLDERS TREE -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="6,6,0,0">
                        <TextBlock Text="Folder Hierarchy" FontWeight="SemiBold" FontSize="13" Foreground="#495057" />
                    </Border>

                    <TreeView Grid.Row="1" 
                              ItemsSource="{Binding RootItem.DirectoryChildren}" 
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              BorderThickness="0" 
                              Padding="4">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="4,3" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemItemViewModel}" ItemsSource="{Binding DirectoryChildren}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="📁" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Foreground="#212529" />
                                    <Border Background="#E9ECEF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="#495057" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- RIGHT PANE: DETAILS DATAGRID -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header with Folder Name & Quick Stats -->
                        <RowDefinition Height="Auto" />
                        <!-- DataGrid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Details Header -->
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12,10" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentFolder.Name, TargetNullValue='No Folder Selected'}" FontWeight="Bold" FontSize="14" Foreground="#212529" VerticalAlignment="Center" />
                                <TextBlock Text=" - " Foreground="#6C757D" VerticalAlignment="Center" Margin="4,0" />
                                <TextBlock Text="{Binding CurrentFolder.FormattedSize, TargetNullValue=''}" FontWeight="SemiBold" Foreground="#0D6EFD" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredItems.Count, StringFormat='{}{0} item(s)'}" FontSize="12" Foreground="#6C757D" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid View -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredItems}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F3F5"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="#FFFFFF"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">

                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔍 Drill Down into Folder" 
                                          Command="{Binding NavigateToFolderCommand}" 
                                          CommandParameter="{Binding SelectedItem}" />
                                <Separator />
                                <MenuItem Header="📁 Open in File Explorer" 
                                          Command="{Binding OpenInExplorerCommand}" 
                                          CommandParameter="{Binding SelectedItem}" />
                                <MenuItem Header="📋 Copy Full Path" 
                                          Command="{Binding CopyPathCommand}" 
                                          CommandParameter="{Binding SelectedItem}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- Column 1: Type / Icon -->
                            <DataGridTemplateColumn Header="Type" Width="70" CanUserSort="True" SortMemberPath="ItemType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemType, Converter={StaticResource ItemTypeToGlyphConverter}}" FontSize="14" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 2: Name -->
                            <DataGridTemplateColumn Header="Name" Width="*" CanUserSort="True" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Medium" 
                                                       FontSize="13" 
                                                       Foreground="#212529"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding FullPath}" />
                                            <!-- Error badge if permission denied -->
                                            <Border Background="#FFEBEE" 
                                                    CornerRadius="3" 
                                                    Padding="4,1" 
                                                    Margin="6,0,0,0" 
                                                    Visibility="{Binding HasAccessError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="{Binding ErrorMessage}">
                                                <TextBlock Text="⚠️ Access Error" Foreground="#C62828" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 3: Size -->
                            <DataGridTemplateColumn Header="Size" Width="110" CanUserSort="True" SortMemberPath="Size">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="13" 
                                                   Foreground="#212529"
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center" 
                                                   Margin="4,2,12,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 4: % of Parent with Visual Bar -->
                            <DataGridTemplateColumn Header="% of Parent" Width="150" CanUserSort="True" SortMemberPath="PercentOfParent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,4,8,4" VerticalAlignment="Center">
                                            <!-- Background Bar Track -->
                                            <Border Height="16" Background="#E9ECEF" CornerRadius="3" />
                                            <!-- Colored Percentage Fill Bar -->
                                            <ProgressBar Height="16" 
                                                         Minimum="0" Maximum="100" 
                                                         Value="{Binding PercentOfParent, Mode=OneWay}" 
                                                         Foreground="{Binding PercentOfParent, Converter={StaticResource PercentageToBrushConverter}}" 
                                                         Background="Transparent"
                                                         BorderThickness="0" />
                                            <!-- Percentage Text Overlay -->
                                            <TextBlock Text="{Binding PercentOfParentText}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="#212529" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 5: Files Count -->
                            <DataGridTemplateColumn Header="Files" Width="80" CanUserSort="True" SortMemberPath="FileCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileCount, StringFormat='{}{0:N0}'}" 
                                                   FontSize="12" 
                                                   Foreground="#6C757D"
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center" 
                                                   Margin="4,2,8,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 6: Subfolders Count -->
                            <DataGridTemplateColumn Header="Folders" Width="80" CanUserSort="True" SortMemberPath="DirectoryCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DirectoryCount, StringFormat='{}{0:N0}'}" 
                                                   FontSize="12" 
                                                   Foreground="#6C757D"
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center" 
                                                   Margin="4,2,8,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 7: Date Modified -->
                            <DataGridTemplateColumn Header="Modified" Width="140" CanUserSort="True" SortMemberPath="LastModified">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                                   FontSize="12" 
                                                   Foreground="#6C757D"
                                                   VerticalAlignment="Center" 
                                                   Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 3: STATUS & PROGRESS BAR -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Status message / live scan text -->
                    <ColumnDefinition Width="*" />
                    <!-- Indeterminate Progress Bar (when scanning) -->
                    <ColumnDefinition Width="180" />
                    <!-- Summary counts -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="#495057" 
                           VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis" />

                <!-- Scan Progress Bar -->
                <ProgressBar Grid.Column="1" 
                             IsIndeterminate="{Binding IsScanning}" 
                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                             Height="12" 
                             Margin="12,0" 
                             VerticalAlignment="Center" />

                <!-- Summary indicators -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#6C757D" Margin="0,0,12,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
